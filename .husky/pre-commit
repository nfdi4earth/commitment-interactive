#!/usr/bin/env sh
if [ "$NO_VERIFY" ]; then
    echo 'pre-commit hook skipped' 1>&2
    exit 0
fi

if ! command -v pnpm >/dev/null 2>&1; then
    echo 'Error: pnpm is not installed or not available in PATH.' 1>&2
    exit 0
fi

echo '--- run linting --- '
pnpm lint

echo '--- run prettier ---'
pnpm prettier-check

echo '--- run typescript check ---'
pnpm check-types

echo '--- run tests ---'
CI=1 pnpm test run # CI=1 disallows `.only` in tests
